# =============================================================================
# Taswoq Production Environment Variables Template (قالب متغيرات الإنتاج)
# انسخ هذا الملف على خادم Linux VPS إلى المسار: /var/www/taswoq/.env
# =============================================================================

# 1. رابط الاتصال بقاعدة بيانات PostgreSQL السحابية (إلزامي)
# إذا كانت قاعدة البيانات على نفس خادم الـ VPS: استخدم 127.0.0.1
# إذا كانت لدى مزود سحابي خارجي: استخدم الرابط المشفر مع sslmode=require
DATABASE_URL=postgresql://taswoq_user:<STRONG_DB_PASSWORD>@127.0.0.1:5432/taswoq_db

# 2. إعدادات استماع خادم بايثون الداخلي (خلف Nginx)
# الاستماع على 127.0.0.1 داخلياً فقط لمنع تعريض منفذ بايثون للإنترنت العام
HOST=127.0.0.1
PORT=8080

# 3. وضع التشغيل (production يفرض الحماية الصارمة ويحظر الأصول المحلية)
ENV=production

# 4. النطاقات المصرح بها لسياسة CORS
# استبدل <نطاقي> بالنطاق الفعلي بعد حجزه (مثال: https://taswoq.com)
ALLOWED_ORIGINS=https://<نطاقي>

# 5. عناوين البروكسي والوكيل العكسي الموثوق (Nginx على نفس الخادم)
TRUSTED_PROXIES=127.0.0.1,::1

# 6. تفعيل سمة Secure الإلزامية لكوكيز الجلسة في بيئة HTTPS
TASWOQ_COOKIE_SECURE=1

